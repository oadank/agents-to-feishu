# agents-to-feishu 配置模板
# 复制为 ~/.agents-to-feishu/config.env 后填写
# 单实例单 bot：CTI_BOT 指定运行时，CTI_BOT_<NAME>_ 前缀为 bot 配置

# ── 全局 ──
CTI_DEFAULT_WORKDIR=C:\D\opt
CTI_FEISHU_ALLOWED_USERS=*
CTI_DASHBOARD_PORT=13590

# ── Bot: dsh ──
CTI_BOT=dsh
CTI_BOT_DSH_APP_ID=cli_a93fe9c803b89cc8
CTI_BOT_DSH_APP_SECRET=在此填写
CTI_BOT_DSH_RUNTIME=dsh
CTI_BOT_DSH_AGENT_NAME=DSH
CTI_BOT_DSH_MODEL_GROUP=deepseek-v4-flash
CTI_BOT_DSH_MODEL_PROVIDER=deepseek
CTI_BOT_DSH_SHOW_TOOL_CALL_CARDS=true
CTI_BOT_DSH_SHOW_AGENT_DIVIDER=true

# ── DSH harness 接入 ──
CTI_DSH_HARNESS_PATH=C:\D\opt\deepseek-harness\deepseek-harness
CTI_DSH_ACP_CONFIG=C:\Users\oadan\.dsh\dsh-bot\cordis.yml
CTI_DSH_ACP_CWD=C:\D\opt
